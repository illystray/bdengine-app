*

# Keep repository metadata / docs
!.gitignore
!README.md
!LICENSE
!TRADEMARKS.md

# Keep the build entry points and dependency lockfile
!package.json
!package-lock.json
!scripts/
scripts/*
!scripts/build.ps1
!scripts/fetch-webview2.ps1
!redist/
redist/*
!redist/README.txt

# Keep the desktop app sources and build resources
!src-tauri/
src-tauri/*
!src-tauri/.gitignore
!src-tauri/src/
!src-tauri/src/**
!src-tauri/icons/
!src-tauri/icons/**
!src-tauri/splash/
src-tauri/splash/*
!src-tauri/splash/splash.png
!src-tauri/splash/splash.pdn
!src-tauri/capabilities/
!src-tauri/capabilities/**
!src-tauri/Cargo.toml
!src-tauri/Cargo.lock
!src-tauri/tauri.conf.json
!src-tauri/build.rs

# Required patched dependency sources
!vendor/
!vendor/wry/
!vendor/wry/**
!vendor/tauri-plugin-http/
!vendor/tauri-plugin-http/**

# Keep the Inno Setup installer script
!installer/
installer/*
!installer/bdengine.iss
